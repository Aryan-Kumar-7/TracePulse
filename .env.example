# ==========================================
# TracePulse Environment Configuration
# ==========================================

# API Gateway Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=v1

# Redis Buffer & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_KEY=tracepulse:stream:traces

# ClickHouse Time-Series Trace Store
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL Relational Metadata Store (Prisma)
POSTGRES_USER=tracepulse
POSTGRES_PASSWORD=tracepulse_secret
POSTGRES_DB=tracepulse
POSTGRES_PORT=5432
DATABASE_URL="postgresql://tracepulse:tracepulse_secret@localhost:5432/tracepulse?schema=public"

# AI Incident Root-Cause Analysis Worker
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini # or "groq"
